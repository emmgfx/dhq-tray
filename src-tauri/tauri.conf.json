{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DHQ Tray",
  "version": "0.1.2",
  "identifier": "com.emmgfx.dhqtray",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DHQ Tray",
        "width": 360,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "state": "active",
          "radius": 12
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "DHQ Tray Local Signing"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDREMzQzVBQTJDRUQxM0EKUldRNjBjNmlXanpjekNmT2VENTFNMHZ1NzFia0lGZU1tNmdNRXlUeDFncHZjeEE3dXdyQnhUZVEK",
      "endpoints": [
        "https://github.com/emmgfx/dhq-tray/releases/latest/download/latest.json"
      ]
    }
  }
}
